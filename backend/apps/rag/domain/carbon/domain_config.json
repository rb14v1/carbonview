{
  "name": "carbon",
  "document_builder": "apps.rag.domain.carbon.document_builders.CarbonDocumentBuilder",
  "sql_handlers": [
    "apps.rag.domain.carbon.sql_handlers.CreditsHandler",
    "apps.rag.domain.carbon.sql_handlers.EnergyHandler",
    "apps.rag.domain.carbon.sql_handlers.WaterHandler",
    "apps.rag.domain.carbon.sql_handlers.WasteHandler",
    "apps.rag.domain.carbon.sql_handlers.EmissionsHandler"
  ],
  "filter_mapping": {
    "entities": {
